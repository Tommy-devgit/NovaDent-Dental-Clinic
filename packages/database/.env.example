# Database package (Prisma CLI + seed script)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Used by `prisma generate/migrate` and `npm run db:seed`.

# Neon Postgres connection string (pooled). Same value across all workspaces.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# First ADMIN staff user created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@novadent.co.uk"
SEED_ADMIN_PASSWORD="change-me-strong-password"
SEED_ADMIN_FIRST_NAME="Nova"
SEED_ADMIN_LAST_NAME="Admin"
