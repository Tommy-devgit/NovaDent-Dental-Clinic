# Dashboard app (staff admin portal)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# Neon Postgres connection string (pooled). Same value across all workspaces.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Secret used to sign/verify the staff session JWT (HS256).
# Generate a strong value with: openssl rand -hex 64
JWT_SECRET="staff-session-signing-secret"
