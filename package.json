{
  "name": "novadent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "npm run dev --workspace=@novadent/landing",
    "dev:dashboard": "npm run dev --workspace=@novadent/dashboard",
    "build:landing": "npm run build --workspace=@novadent/landing",
    "build:dashboard": "npm run build --workspace=@novadent/dashboard",
    "db:generate": "npm run generate --workspace=@novadent/database",
    "db:seed": "npm run db:seed --workspace=@novadent/database"
  }
}
