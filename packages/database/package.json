{
  "name": "@novadent/database",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "generate": "node --env-file=.env ../../node_modules/prisma/build/index.js generate",
    "migrate:deploy": "node --env-file=.env ../../node_modules/prisma/build/index.js migrate deploy",
    "migrate:resolve": "node --env-file=.env ../../node_modules/prisma/build/index.js migrate resolve",
    "db:seed": "node --env-file=.env ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@novadent/utils": "*",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "tsx": "^4.19.2"
  }
}
